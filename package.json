{
  "name": "nexus-downloader",
  "version": "1.0.1",
  "description": "Downloader inteligente e ultrarrápido de mídias e pastas (Google Drive, Bunkr, etc.).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "keywords": [
    "google-drive",
    "downloader",
    "electron",
    "sequential"
  ],
  "author": "Antigravity",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "googleapis": "^140.0.1"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nexus.downloader",
    "productName": "Nexus Downloader",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "alazter",
      "repo": "nexus-downloader"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "renderer/icon.png"
    },
    "portable": {
      "artifactName": "Nexus-Downloader-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Nexus-Downloader-Setup-${version}.${ext}"
    }
  }
}
