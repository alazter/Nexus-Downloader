{
  "name": "nexus-downloader",
  "version": "1.0.0",
  "description": "Downloader inteligente e ultrarrápido de mídias e pastas (Google Drive, Bunkr, etc.).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "keywords": [
    "google-drive",
    "downloader",
    "electron",
    "sequential"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "googleapis": "^140.0.1"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nexus.downloader",
    "productName": "Nexus Downloader",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
